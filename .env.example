# Required
OPENAI_API_KEY=sk-...

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=educational_resources

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Rate limit on /generate-roadmap and /v1/roadmap/stream, per client IP
RATE_LIMIT=5/minute

# Structured-output model for roadmap generation (gpt-4o-mini is well within
# range for this task per the eval harness — see DECISIONS.md; set to
# gpt-4o to revert to the more expensive/slower model)
ROADMAP_MODEL=gpt-4o-mini

# Optional — enables the Redis cache backend. Unset = in-process LRU cache
# only (fine for a single instance; use Redis once you run multiple workers
# or replicas so cache hits are shared).
# REDIS_URL=redis://localhost:6379/0
