# Required
OPENAI_API_KEY=sk-...

# Qdrant — QDRANT_API_KEY only needed for a managed instance (e.g. Qdrant
# Cloud); leave unset for a local `docker-compose up` Qdrant, which needs no key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=educational_resources

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Rate limit on /generate-roadmap and /v1/roadmap/stream, per client IP
RATE_LIMIT=5/minute

# Structured-output model for roadmap generation. gpt-4.1-nano (default):
# a live before/after comparison showed it ~30-40% faster than gpt-4o-mini
# for this task and cheaper on both input/output tokens, with comparably
# coherent staged output — see DECISIONS.md for the comparison data and
# the one real tradeoff (slightly more linear, less branching DAGs).
ROADMAP_MODEL=gpt-4.1-nano

# Optional — enables the Redis cache backend. Unset = in-process LRU cache
# only (fine for a single instance; use Redis once you run multiple workers
# or replicas so cache hits are shared).
# REDIS_URL=redis://localhost:6379/0
